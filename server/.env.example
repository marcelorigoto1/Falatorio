# Copie este arquivo para ".env" e preencha.
# O arquivo .env fica de fora do Git (veja o .gitignore) — nunca suba senhas
# para o repositorio. No Render, use Environment em vez deste arquivo.

# Senha para entrar na sala. Vazio ou ausente = sala aberta.
ROOM_PASSWORD=

# Quantas pessoas cabem na sala ao mesmo tempo (padrao 12).
MAX_USERS=12
